<Window x:Class="Tracos3DStudio.PartsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista de peças"
        Width="980"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        AutomationProperties.Name="Janela lista de peças"
        AutomationProperties.AutomationId="PartsListWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ProjectTitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Espessura painel (mm)" VerticalAlignment="Center"/>
            <ComboBox x:Name="PanelThicknessCombo"
                      Width="80"
                      Margin="8,0,0,0"
                      AutomationProperties.AutomationId="PanelThicknessCombo">
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="25"/>
            </ComboBox>
            <TextBlock x:Name="PieceCountText"
                       Margin="24,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="PartsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AutomationProperties.AutomationId="PartsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Módulo" Binding="{Binding ModuleName}" Width="130"/>
                <DataGridTextColumn Header="Peça" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="L × A × E (mm)" Binding="{Binding DimensionsText}" Width="150"/>
                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="50"/>
                <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="110"/>
                <DataGridTextColumn Header="Furos" Binding="{Binding DrillingText}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Exportar etiquetas PDF..."
                    Width="150"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportLabelsPdf_Click"
                    AutomationProperties.AutomationId="ExportLabelsPdfButton"/>
            <Button Content="Exportar PDF técnico..."
                    Width="150"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportTechnicalPdf_Click"
                    AutomationProperties.AutomationId="ExportTechnicalPdfButton"/>
            <Button Content="Exportar DXF planta..."
                    Width="140"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportDxf_Click"
                    AutomationProperties.AutomationId="ExportDxfButton"/>
            <Button Content="Exportar DXF peças..."
                    Width="140"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportDxfPieces_Click"
                    AutomationProperties.AutomationId="ExportDxfPiecesButton"/>
            <Button Content="Fechar"
                    Width="88"
                    Height="32"
                    IsCancel="True"
                    Click="Close_Click"
                    AutomationProperties.AutomationId="PartsListCloseButton"/>
        </StackPanel>
    </Grid>
</Window>
