<Window x:Class="Tracos3DStudio.DimensionConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurador de Dimensões"
        Width="800"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        AutomationProperties.Name="Configurador de Dimensões"
        AutomationProperties.AutomationId="DimensionConfiguratorWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Sem checkbox: Aplicar ou OK grava o padrão de engenharia (novos módulos). Com checkbox: Aplicar envia aos módulos da cena; o painel volta ao padrão salvo. OK só fecha."
                   TextWrapping="Wrap"
                   Foreground="#666666"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="CategoryTree"
                      Grid.Column="0"
                      SelectedItemChanged="CategoryTree_SelectedItemChanged"
                      AutomationProperties.AutomationId="DimensionConfiguratorCategoryTree">
                <TreeViewItem Header="Medidas Máximas" Tag="max" IsSelected="True"/>
                <TreeViewItem Header="Cozinhas">
                    <TreeViewItem Header="Dimensões Externas" Tag="coz-ext"/>
                    <TreeViewItem x:Name="CozinhaChapasTreeItem" Header="Chapas" Tag="coz-chapa-group"/>
                    <TreeViewItem x:Name="CozinhaBoxInferiorTreeItem" Header="Montagem da Caixa - Inferior" Tag="coz-box-inf-group"/>
                    <TreeViewItem x:Name="CozinhaBoxSuperiorTreeItem" Header="Montagem da Caixa - Superior" Tag="coz-box-sup-group"/>
                    <TreeViewItem x:Name="CozinhaBoxDespenseirosTreeItem" Header="Montagem da Caixa - Despenseiros | Torres"
                                  Tag="coz-box-desp-group"
                                  AutomationProperties.AutomationId="CozinhaBoxDespenseirosTreeItem"/>
                    <TreeViewItem x:Name="CozinhaEletrosTreeItem" Header="Eletros"
                                  Tag="coz-eletros-group"
                                  AutomationProperties.AutomationId="CozinhaEletrosTreeItem"/>
                    <TreeViewItem x:Name="CozinhaFrentesPortasTreeItem" Header="Frentes | Portas"
                                  Tag="coz-portas-group"
                                  AutomationProperties.AutomationId="CozinhaFrentesPortasTreeItem"/>
                    <TreeViewItem x:Name="CozinhaGavetasTreeItem" Header="Gavetas"
                                  Tag="coz-gavetas-group"
                                  AutomationProperties.AutomationId="CozinhaGavetasTreeItem"/>
                    <TreeViewItem x:Name="CozinhaGavetasInternasTreeItem" Header="Gavetas Internas | Auxiliares"
                                  Tag="coz-gavint-group"
                                  AutomationProperties.AutomationId="CozinhaGavetasInternasTreeItem"/>
                    <TreeViewItem x:Name="CozinhaCavaTreeItem" Header="Cozinhas Cava"
                                  Tag="coz-cava-group"
                                  AutomationProperties.AutomationId="CozinhaCavaTreeItem"/>
                </TreeViewItem>
                <TreeViewItem Header="Dormitórios">
                    <TreeViewItem Header="Dimensões Externas" Tag="dor-ext"/>
                    <TreeViewItem x:Name="DormitorioChapasTreeItem" Header="Chapas" Tag="dor-chapa-group"/>
                    <TreeViewItem x:Name="DormitorioChapasComponentesTreeItem" Header="Componentes" Tag="dor-componentes-group"/>
                    <TreeViewItem x:Name="DormitorioChapasGavetasSapateirasTreeItem" Header="Gavetas | Sapateiras" Tag="dor-gav-sap-group"/>
                    <TreeViewItem x:Name="DormitorioBoxArmarioTreeItem" Header="Montagem da Caixa - Armários" Tag="dor-box-arm-group"/>
                    <TreeViewItem x:Name="DormitorioBoxBancadaCriadoTreeItem" Header="Montagem de Caixa - Bancadas | Criados" Tag="dor-box-banc-group"/>
                    <TreeViewItem x:Name="DormitorioBoxSuperiorTreeItem" Header="Montagem de Caixa - Superior" Tag="dor-box-sup-group"/>
                    <TreeViewItem x:Name="DormitorioFrentesPortasTreeItem" Header="Frentes | Portas" Tag="dor-portas-group"/>
                    <TreeViewItem x:Name="DormitorioGavetasTreeItem" Header="Gavetas" Tag="dor-gavetas-group"/>
                </TreeViewItem>
                <TreeViewItem Header="Painéis">
                    <TreeViewItem Header="Dimensões Externas" Tag="pan-ext"/>
                    <TreeViewItem Header="Chapas" Tag="pan-chapas"/>
                </TreeViewItem>
            </TreeView>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FieldsPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,8">
            <CheckBox x:Name="ApplySelectedCheck"
                      Content="Aplicar nos itens selecionados"
                      Margin="0,0,16,0"
                      AutomationProperties.AutomationId="DimensionConfiguratorApplySelectedCheck"/>
            <CheckBox x:Name="ApplyAllCheck"
                      Content="Aplicar nos itens existentes"
                      AutomationProperties.AutomationId="DimensionConfiguratorApplyAllCheck"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aplicar"
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="Apply_Click"
                    AutomationProperties.AutomationId="DimensionConfiguratorApplyButton"/>
            <Button Content="OK"
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Ok_Click"
                    AutomationProperties.AutomationId="DimensionConfiguratorOkButton"/>
            <Button Content="Cancelar"
                    Width="88"
                    Height="32"
                    IsCancel="True"
                    Click="Cancel_Click"
                    AutomationProperties.AutomationId="DimensionConfiguratorCancelButton"/>
        </StackPanel>
    </Grid>
</Window>
