<Window x:Class="Tracos3DStudio.CutPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plano de corte"
        Width="960"
        Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        AutomationProperties.Name="Janela plano de corte"
        AutomationProperties.AutomationId="CutPlanWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ProjectTitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center"/>
            <TextBlock Text="Chapa (L × A mm)" Margin="24,0,8,0" VerticalAlignment="Center"/>
            <TextBox x:Name="SheetLengthBox"
                     Width="64"
                     Margin="0,0,4,0"
                     AutomationProperties.AutomationId="SheetLengthBox"/>
            <TextBlock Text="×" VerticalAlignment="Center"/>
            <TextBox x:Name="SheetWidthBox"
                     Width="64"
                     Margin="4,0,0,0"
                     AutomationProperties.AutomationId="SheetWidthBox"/>
            <Button Content="Recalcular"
                    Width="88"
                    Height="28"
                    Margin="12,0,0,0"
                    Click="Recalculate_Click"
                    AutomationProperties.AutomationId="CutPlanRecalculateButton"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SheetsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Exportar CSV..."
                    Width="120"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportCsv_Click"
                    AutomationProperties.AutomationId="CutPlanExportCsvButton"/>
            <Button Content="Exportar CSV furos CNC..."
                    Width="150"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportCncDrillCsv_Click"
                    AutomationProperties.AutomationId="CutPlanExportCncDrillCsvButton"/>
            <Button Content="Exportar JSON CNC..."
                    Width="130"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportCncJobJson_Click"
                    AutomationProperties.AutomationId="CutPlanExportCncJobJsonButton"/>
            <Button Content="Exportar .tap Jaraguá..."
                    Width="130"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportJaraguaTap_Click"
                    AutomationProperties.AutomationId="CutPlanExportJaraguaTapButton"/>
            <Button Content="Fechar"
                    Width="88"
                    Height="32"
                    IsCancel="True"
                    Click="Close_Click"
                    AutomationProperties.AutomationId="CutPlanCloseButton"/>
        </StackPanel>
    </Grid>
</Window>
