<Window x:Class="Tracos3DStudio.LibraryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca da marcenaria"
        Width="720"
        Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        AutomationProperties.Name="Editor de biblioteca"
        AutomationProperties.AutomationId="LibraryEditorWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Identidade no orçamento" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Nome da marcenaria"/>
                <TextBox x:Name="CompanyNameBox" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Width="280">
                <TextBlock Text="Logo (PNG/JPG)"/>
                <TextBox x:Name="LogoPathBox"
                         Margin="0,4,0,0"
                         IsReadOnly="True"
                         AutomationProperties.AutomationId="LibraryLogoPathBox"/>
            </StackPanel>
            <Button Grid.Column="4"
                    Content="Logo..."
                    Width="72"
                    Height="28"
                    VerticalAlignment="Bottom"
                    Click="BrowseLogo_Click"
                    AutomationProperties.AutomationId="LibraryBrowseLogoButton"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Módulos personalizados" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="LibraryPathText" Foreground="#666" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid Grid.Row="3"
                  x:Name="ModulesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  AutomationProperties.AutomationId="LibraryModulesGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="L × A × P" Binding="{Binding DimensionsText}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Portas" Binding="{Binding DoorCount}" Width="55"/>
                <DataGridTextColumn Header="Gavetas" Binding="{Binding DrawerCount}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Adicionar módulo"
                        Width="120"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="AddModule_Click"
                        AutomationProperties.AutomationId="LibraryAddModuleButton"/>
                <Button Content="Remover selecionado"
                        Width="130"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="RemoveModule_Click"
                        AutomationProperties.AutomationId="LibraryRemoveModuleButton"/>
                <Button Content="Editar modulação..."
                        Width="140"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="EditModulation_Click"
                        AutomationProperties.AutomationId="LibraryEditModulationButton"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Recarregar do disco"
                        Width="130"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="ReloadFromDisk_Click"
                        AutomationProperties.AutomationId="LibraryReloadFromDiskButton"/>
                <Button Content="Importar..."
                        Width="96"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="Import_Click"
                        AutomationProperties.AutomationId="LibraryImportButton"/>
                <Button Content="Exportar..."
                        Width="96"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="Export_Click"
                        AutomationProperties.AutomationId="LibraryExportButton"/>
                <Button Content="Salvar"
                        Width="80"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="Save_Click"
                        AutomationProperties.AutomationId="LibrarySaveButton"/>
                <Button Content="Fechar"
                        Width="80"
                        Height="32"
                        IsCancel="True"
                        Click="Close_Click"
                        AutomationProperties.AutomationId="LibraryCloseButton"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
