<Window x:Class="Tracos3DStudio.BudgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tracos3DStudio"
        Title="Orçamento"
        Width="920"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        AutomationProperties.Name="Janela de orçamento"
        AutomationProperties.AutomationId="BudgetWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ProjectTitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Expander Grid.Row="1"
                  Header="Dados do cliente"
                  IsExpanded="True"
                  Margin="0,0,0,12"
                  AutomationProperties.AutomationId="BudgetClientExpander">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <local:ClientDataFieldsPanel x:Name="ClientFields"
                                             FieldsChanged="ClientFields_FieldsChanged"/>
            </ScrollViewer>
        </Expander>

        <DataGrid Grid.Row="2"
                  x:Name="BudgetGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AutomationProperties.AutomationId="BudgetGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Módulo" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="L × A × P (mm)" Binding="{Binding DimensionsText}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Base (R$)" Binding="{Binding BasePrice, StringFormat=F2}" Width="90"/>
                <DataGridTextColumn Header="Acab. (R$)" Binding="{Binding MaterialAddOn, StringFormat=F2}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Total (R$)" Binding="{Binding Total, StringFormat=F2}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                x:Name="AuditPanel"
                Background="#FFF3E0"
                BorderBrush="#FFB74D"
                BorderThickness="1"
                Padding="10"
                Margin="0,8,0,0"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="BudgetAuditPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AuditSummaryText"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="BudgetAuditSummaryText"/>
                <Button Grid.Column="1"
                        Content="Ver auditoria..."
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Padding="10,4"
                        Click="OpenAudit_Click"
                        AutomationProperties.AutomationId="BudgetOpenAuditButton"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   x:Name="GrandTotalText"
                   HorizontalAlignment="Right"
                   Margin="0,12,0,12"
                   FontSize="15"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Exportar PDF..."
                    Width="120"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="ExportPdf_Click"
                    AutomationProperties.AutomationId="BudgetExportPdfButton"/>
            <Button Content="Fechar"
                    Width="88"
                    Height="32"
                    IsCancel="True"
                    Click="Close_Click"
                    AutomationProperties.AutomationId="BudgetCloseButton"/>
        </StackPanel>
    </Grid>
</Window>
