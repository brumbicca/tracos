                                              Margin="0,2,0,0"
                                              SelectedIndex="0"
                                              SelectionChanged="WallMeasureSideCombo_SelectionChanged"
                                              AutomationProperties.Name="Orientação da parede selecionada"
                                              AutomationProperties.AutomationId="WallMeasureSideCombo">
                                        <ComboBoxItem Content="Interna"/>
                                        <ComboBoxItem Content="Externa"/>
                                    </ComboBox>
                                    <TextBlock Text="Espessura (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallThicknessBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallPropertyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Espessura da parede"
                                             AutomationProperties.AutomationId="WallThicknessBox"/>
                                    <TextBlock Text="Pé-direito Inicial (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallHeightStartBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallPropertyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Pé-direito inicial"
                                             AutomationProperties.AutomationId="WallHeightStartBox"/>
                                    <TextBlock Text="Pé-direito Final (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallHeightEndBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallPropertyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Pé-direito final"
                                             AutomationProperties.AutomationId="WallHeightEndBox"/>
                                    <TextBlock Text="Ângulo Absoluto (°)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallAngleAbsoluteBox"
                                             Margin="0,2,0,0"
                                             IsReadOnly="True"
                                             Background="#EFEFEF"
                                             AutomationProperties.Name="Ângulo absoluto"
                                             AutomationProperties.AutomationId="WallAngleAbsoluteBox"/>
                                    <TextBlock Text="Ângulo Relativo (°)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallAngleRelativeBox"
                                             Margin="0,2,0,0"
                                             IsReadOnly="True"
                                             Background="#EFEFEF"
                                             AutomationProperties.Name="Ângulo relativo"
                                             AutomationProperties.AutomationId="WallAngleRelativeBox"/>
                                    <TextBlock Text="Flecha (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallFlechaBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallPropertyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Flecha da parede"
                                             AutomationProperties.AutomationId="WallFlechaBox"/>
                                    <TextBlock Text="Ângulo do Arco (°)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallArcAngleBox"
                                             Margin="0,2,0,0"
                                             IsReadOnly="True"
                                             Background="#EFEFEF"
                                             AutomationProperties.Name="Ângulo do arco"
                                             AutomationProperties.AutomationId="WallArcAngleBox"/>
                                    <TextBlock x:Name="WallDimensionHintText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Enter confirma cada campo."/>
                                    <Button x:Name="WallSegmentButton"
                                            Content="Segmentar parede"
                                            Margin="0,10,0,0"
                                            Height="32"
                                            Click="WallSegmentButton_Click"
                                            AutomationProperties.Name="Segmentar parede"
                                            AutomationProperties.AutomationId="WallSegmentButton"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="30-40-50" Margin="0,6,0,0" IsExpanded="False">
                                <StackPanel>
                                    <TextBlock Text="Medida A (mm)" />
                                    <TextBox x:Name="Wall304050ABox"
                                             Margin="0,2,0,0"
                                             AutomationProperties.Name="Medida A 30-40-50"
                                             AutomationProperties.AutomationId="Wall304050ABox"/>
                                    <TextBlock Text="Medida B (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="Wall304050BBox"
                                             Margin="0,2,0,0"
                                             AutomationProperties.Name="Medida B 30-40-50"
                                             AutomationProperties.AutomationId="Wall304050BBox"/>
                                    <TextBlock Text="Medida C (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="Wall304050CBox"
                                             Margin="0,2,0,0"
                                             AutomationProperties.Name="Medida C 30-40-50"
                                             AutomationProperties.AutomationId="Wall304050CBox"/>
                                    <Button x:Name="Wall304050PickMovingButton"
                                            Content="Selecionar parede deslocada"
                                            Margin="0,8,0,0"
                                            Height="32"
                                            Click="Wall304050PickMovingButton_Click"
                                            AutomationProperties.Name="Selecionar parede deslocada"
                                            AutomationProperties.AutomationId="Wall304050PickMovingButton"/>
                                    <Button x:Name="Wall304050ApplyButton"
                                            Content="Aplicar 30-40-50"
                                            Margin="0,6,0,0"
                                            Height="32"
                                            Click="Wall304050ApplyButton_Click"
                                            AutomationProperties.Name="Aplicar 30-40-50"
                                            AutomationProperties.AutomationId="Wall304050ApplyButton"/>
                                    <TextBlock x:Name="Wall304050HintText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="A e B a partir do canto na parede de referência; C entre os pontos medidos."/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Cotas" Margin="0,6,0,0" IsExpanded="False">
                                <StackPanel>
                                    <TextBlock Text="Afastamento Piso (mm)"/>
