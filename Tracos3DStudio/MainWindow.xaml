                                              Click="WallIsMovableCheck_Click"
                                              AutomationProperties.AutomationId="WallIsMovableCheck"/>
                                    <CheckBox x:Name="WallIsVisibleCheck"
                                              Margin="0,8,0,0"
                                              Content="Visível"
                                              IsChecked="True"
                                              Click="WallIsVisibleCheck_Click"
                                              AutomationProperties.AutomationId="WallIsVisibleCheck"/>
                                    <TextBlock Text="Camada" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="WallLayerCombo"
                                              Margin="0,2,0,0"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="WallLayerCombo_SelectionChanged"
                                              AutomationProperties.Name="Camada da parede"
                                              AutomationProperties.AutomationId="WallLayerCombo"/>
                                    <TextBlock Text="Cômodo" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="WallCompartmentCombo"
                                              Margin="0,2,0,0"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="WallCompartmentCombo_SelectionChanged"
                                              AutomationProperties.Name="Cômodo da parede"
                                              AutomationProperties.AutomationId="WallCompartmentCombo"/>
                                </StackPanel>
                            </Expander>

