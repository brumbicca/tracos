                                <StackPanel>
                                    <TextBlock Text="Comprimento (mm)"/>
                                    <TextBox x:Name="WallConstructionLengthBox"
                                             Margin="0,2,0,0"
                                             IsReadOnly="True"
                                             Background="#EFEFEF"
                                             AutomationProperties.Name="Comprimento em construção"
                                             AutomationProperties.AutomationId="WallConstructionLengthBox"/>
                                    <TextBlock Text="Orientação" Margin="0,6,0,0"/>
                                    <ComboBox x:Name="WallConstructionMeasureSideCombo"
                                              Margin="0,2,0,0"
                                              SelectedIndex="0"
                                              SelectionChanged="WallMeasureSideCombo_SelectionChanged"
                                              AutomationProperties.Name="Orientação da parede"
                                              AutomationProperties.AutomationId="WallConstructionMeasureSideCombo">
                                        <ComboBoxItem Content="Interna"/>
                                        <ComboBoxItem Content="Externa"/>
                                    </ComboBox>
                                    <TextBlock Text="Espessura (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallConstructionThicknessBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallConstructionBox_PreviewKeyDown"
                                             AutomationProperties.Name="Espessura em construção"
                                             AutomationProperties.AutomationId="WallConstructionThicknessBox"/>
                                    <TextBlock Text="Altura (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallConstructionHeightBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallConstructionBox_PreviewKeyDown"
                                             AutomationProperties.Name="Altura em construção"
                                             AutomationProperties.AutomationId="WallConstructionHeightBox"/>
                                    <TextBlock Text="Ângulo Absoluto (°)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallConstructionAngleAbsoluteBox"
                                             Margin="0,2,0,0"
                                             IsReadOnly="True"
                                             Background="#EFEFEF"
                                             AutomationProperties.AutomationId="WallConstructionAngleAbsoluteBox"/>
                                    <TextBlock Text="Ângulo Relativo (°)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallConstructionAngleRelativeBox"
                                             Margin="0,2,0,0"
                                             IsReadOnly="True"
                                             Background="#EFEFEF"
                                             AutomationProperties.AutomationId="WallConstructionAngleRelativeBox"/>
                                    <TextBlock x:Name="WallConstructionHintText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Orientação define o lado do Comprimento (Promob). Desenhe no sentido horário. R alterna Orientação."/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Aparar Cantos" Margin="0,6,0,0" IsExpanded="False">
                                <StackPanel>
                                    <TextBlock Text="Aparo chanfro (mm)"/>
                                    <TextBox x:Name="WallChamferDistanceBox"
                                             Margin="0,2,0,0"
                                             AutomationProperties.Name="Aparo chanfro"
                                             AutomationProperties.AutomationId="WallChamferDistanceBox"/>
                                    <Button x:Name="WallChamferButton"
                                            Content="Aparar Parede"
                                            Margin="0,8,0,0"
                                            Height="32"
                                            Click="WallChamferButton_Click"
                                            AutomationProperties.Name="Aparar Parede"
                                            AutomationProperties.AutomationId="WallChamferButton"/>
                                    <TextBlock x:Name="WallChamferHintText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Chanfro: clique no canto da parede (hotpoint). Esc cancela."/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

