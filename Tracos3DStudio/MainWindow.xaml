                             ═══════════════════════════════════════════ -->
                        <StackPanel x:Name="WallPropertiesPanel" Visibility="Collapsed">

                            <Expander Header="Dimensões" IsExpanded="True"
                                      AutomationProperties.AutomationId="WallDimensionsExpander">
                                <StackPanel>
                                    <TextBlock Text="Comprimento (mm)"/>
                                    <TextBox x:Name="WallLengthBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallPropertyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Comprimento da parede"
                                             AutomationProperties.AutomationId="WallLengthBox"/>
