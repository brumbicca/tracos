                                              SelectionChanged="WallBandSelectorCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="WallBandSelectorCombo"/>
                                    <TextBlock Text="Material da faixa" Margin="0,6,0,0"/>
                                    <ComboBox x:Name="WallBandMaterialCombo"
                                              Margin="0,2,0,0"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="WallBandMaterialCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="WallBandMaterialCombo"/>
                                    <TextBlock x:Name="WallBandsSummaryText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Nenhuma faixa."/>
                                </StackPanel>
                            </Expander>

