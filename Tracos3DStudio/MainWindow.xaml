                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallPropertyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Afastamento piso"
                                             AutomationProperties.AutomationId="WallFloorOffsetBox"/>
                                    <TextBlock Text="Cota Anterior (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallCotaAnteriorBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallPropertyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Cota anterior"
                                             AutomationProperties.AutomationId="WallCotaAnteriorBox"/>
                                    <TextBlock Text="Cota Posterior (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallCotaPosteriorBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="WallPropertyBox_PreviewKeyDown"
                                             AutomationProperties.Name="Cota posterior"
                                             AutomationProperties.AutomationId="WallCotaPosteriorBox"/>
                                    <TextBlock Text="Cota Inferior (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="WallCotaInferiorBox"
