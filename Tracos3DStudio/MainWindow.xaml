                                               Text="Regiões na face (retângulo, círculo ou polígono). Arraste o contorno azul no viewport para ajustar (10 mm). Offset expande a borda."/>
                                    <TextBlock Text="Componente" Margin="0,6,0,0"/>
                                    <ComboBox x:Name="WallRegionFaceCombo"
                                              Margin="0,2,0,0"
                                              SelectedIndex="0"
                                              SelectionChanged="WallRegionFaceCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="WallRegionFaceCombo">
                                        <ComboBoxItem Content="Face interna"/>
                                        <ComboBoxItem Content="Face externa"/>
                                    </ComboBox>
                                    <TextBlock Text="Material da face" Margin="0,6,0,0"/>
