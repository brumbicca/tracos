                                                 PreviewKeyDown="PropertyRegionOffsetEdgeBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PropertyRegionOffsetStartAlongBox"/>
                                        <TextBox x:Name="PropertyRegionOffsetEndAlongBox"
