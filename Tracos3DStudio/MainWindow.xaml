                                              SelectionChanged="WallFaceMaterialCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="WallFaceMaterialCombo"/>
                                    <Button x:Name="WallAddRegionButton"
                                            Margin="0,8,0,0"
