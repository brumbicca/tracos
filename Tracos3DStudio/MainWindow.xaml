                                              SelectionChanged="WallRegionSelectorCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="WallRegionSelectorCombo"/>
                                    <TextBlock Text="Material da região" Margin="0,6,0,0"/>
                                    <ComboBox x:Name="WallRegionMaterialCombo"
                                              Margin="0,2,0,0"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="WallRegionMaterialCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="WallRegionMaterialCombo"/>
                                    <TextBlock Text="Offset forma (mm)" Margin="0,6,0,0"/>
