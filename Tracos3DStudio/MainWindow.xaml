<Window x:Class="Tracos3DStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:local="clr-namespace:Tracos3DStudio"
        Title="Tracos 3D Studio V1"
        WindowState="Maximized"
        Background="#F2F2F2"
        AutomationProperties.Name="Tracos 3D Studio V1"
        AutomationProperties.AutomationId="MainWindow"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LibraryColumn" Width="250" MinWidth="160" MaxWidth="600"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition x:Name="PropertiesColumn" Width="280" MinWidth="220" MaxWidth="650"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#E0E0E0" BorderBrush="#C8C8C8" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="ProjectTabNewButton"
                        DockPanel.Dock="Right"
                        Content="+"
                        Width="28"
                        Height="24"
                        Margin="2,2,4,2"
                        ToolTip="Novo projeto em nova aba"
                        Click="ProjectTabNew_Click"
                        AutomationProperties.AutomationId="ProjectTabNewButton"/>
                <ListBox x:Name="ProjectTabList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="ProjectTabList_SelectionChanged"
                         AutomationProperties.AutomationId="ProjectTabBar">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2,2,0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder"
                                                Background="#F2F2F2"
                                                BorderBrush="#C8C8C8"
                                                BorderThickness="1,1,1,0"
                                                CornerRadius="4,4,0,0"
                                                Padding="0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#A0A0A0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                <Button Content="×"
                                        Width="18"
                                        Height="18"
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        ToolTip="Fechar aba"
                                        Click="ProjectTabClose_Click"
                                        Tag="{Binding}"
                                        AutomationProperties.AutomationId="ProjectTabCloseButton"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Menu x:Name="MainMenu" Grid.Row="1" Grid.ColumnSpan="3" Background="#F2F2F2">
            <MenuItem Header="Arquivo">
                <MenuItem Header="Novo" Click="NewProject_Click" InputGestureText=""/>
                <MenuItem Header="Abrir..." Click="OpenProject_Click"/>
                <Separator/>
                <MenuItem Header="Salvar" Click="SaveProject_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Salvar como..." Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="Fechar aba"
                          Click="CloseProjectTab_Click"
                          InputGestureText="Ctrl+W"
                          AutomationProperties.AutomationId="CloseProjectTabMenuItem"/>
            </MenuItem>
            <MenuItem Header="Editar"/>
            <MenuItem Header="Exibir">
                <MenuItem Header="Camadas..."
                          Click="OpenWallLayers_Click"
                          AutomationProperties.AutomationId="WallLayersMenuItem"/>
                <MenuItem Header="Materiais..."
                          Click="OpenMaterials_Click"
                          AutomationProperties.AutomationId="MaterialsMenuItem"/>
                <MenuItem Header="Editor de Faixas..."
                          Click="OpenWallBandsEditor_Click"
                          AutomationProperties.AutomationId="WallBandsEditorMenuItem"/>
                <Separator/>
                <MenuItem Header="Exportar viewport PNG..." Click="ExportViewportPng_Click"/>
                <MenuItem Header="Exportar PNG apresentação (2x, só 3D)..."
                          Click="ExportPresentationPng_Click"
                          AutomationProperties.AutomationId="ExportPresentationPngMenuItem"/>
                <MenuItem Header="Exportar PNG planta com cotas..." Click="ExportFloorPlanPng_Click"/>
                <Separator/>
                <MenuItem Header="Alternar teto automático" Click="ToggleAutomaticCeiling_Click"/>
            </MenuItem>
            <MenuItem Header="Inserir"/>
            <MenuItem Header="Projeto">
                <MenuItem Header="Dados do cliente e da obra..."
                          Click="OpenProjectClientData_Click"
                          AutomationProperties.AutomationId="ProjectClientDataMenuItem"/>
                <MenuItem Header="Adicionar cômodo..."
                          Click="AddCompartment_Click"
                          AutomationProperties.AutomationId="AddCompartmentMenuItem"/>
                <Separator/>
                <MenuItem Header="Lista de peças..."
                          Click="OpenPartsList_Click"
                          AutomationProperties.AutomationId="PartsListMenuItem"/>
                <MenuItem Header="Exportar PDF técnico..."
                          Click="ExportTechnicalPdf_Click"
                          AutomationProperties.AutomationId="ExportTechnicalPdfMenuItem"/>
                <MenuItem Header="Exportar DXF planta..."
                          Click="ExportDxf_Click"
                          AutomationProperties.AutomationId="ExportDxfFloorPlanMenuItem"/>
                <MenuItem Header="Exportar DXF peças..."
                          Click="ExportDxfPieces_Click"
                          AutomationProperties.AutomationId="ExportDxfPiecesMenuItem"/>
                <MenuItem Header="Importar DXF planta..." Click="ImportDxf_Click"/>
                <Separator/>
                <MenuItem Header="Perfil de construção">
                    <MenuItem Header="Padrão (18 mm)" Click="ConstructionProfilePadrao_Click"/>
                    <MenuItem Header="Reforçado (25 mm)" Click="ConstructionProfileReforcado_Click"/>
                    <MenuItem Header="Econômico (15 mm)" Click="ConstructionProfileEconomico_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Produção">
                <MenuItem Header="Abrir plano de corte..."
                          Click="OpenCutPlan_Click"
                          AutomationProperties.AutomationId="OpenCutPlanMenuItem"/>
                <MenuItem Header="Exportar CSV plano de corte..."
                          Click="ExportCutPlanCsv_Click"
                          AutomationProperties.AutomationId="ExportCutPlanCsvMenuItem"/>
                <MenuItem Header="Exportar JSON plano de corte (máquina)..."
                          Click="ExportMachineCutPlanJson_Click"
                          AutomationProperties.AutomationId="ExportMachineCutPlanJsonMenuItem"/>
                <MenuItem Header="Exportar CSV furos CNC..."
                          Click="ExportCncDrillCsv_Click"
                          AutomationProperties.AutomationId="ExportCncDrillCsvMenuItem"/>
                <MenuItem Header="Exportar JSON CNC (tracos-cnc-job)..."
                          Click="ExportCncJobJson_Click"
                          AutomationProperties.AutomationId="ExportCncJobJsonMenuItem"/>
                <MenuItem Header="Exportar .tap Jaraguá (Mach4)..."
                          Click="ExportJaraguaTap_Click"
                          AutomationProperties.AutomationId="ExportJaraguaTapMenuItem"/>
                <MenuItem Header="Exportar etiquetas PDF..."
                          Click="ExportPartLabelsPdf_Click"
                          AutomationProperties.AutomationId="ExportPartLabelsPdfMenuItem"/>
            </MenuItem>
            <MenuItem Header="Orçamento">
                <MenuItem Header="Auditar projeto..."
                          Click="AuditBudget_Click"
                          AutomationProperties.AutomationId="AuditBudgetMenuItem"/>
                <MenuItem Header="Abrir orçamento..."
                          Click="OpenBudget_Click"
                          AutomationProperties.AutomationId="OpenBudgetMenuItem"/>
            </MenuItem>
            <MenuItem Header="Ferramentas">
                <MenuItem Header="Configurar Dimensões..."
                          Click="OpenDimensionConfigurator_Click"
                          AutomationProperties.AutomationId="OpenDimensionConfiguratorMenuItem"/>
                <Separator/>
                <MenuItem Header="Gerenciar biblioteca..." Click="OpenLibraryEditor_Click"
                          AutomationProperties.AutomationId="OpenLibraryEditorMenuItem"/>
                <MenuItem Header="Recarregar biblioteca"
                          Click="ReloadLibrary_Click"
                          AutomationProperties.AutomationId="ReloadLibraryMenuItem"/>
                <MenuItem Header="Exportar pacote ERP..." Click="ExportErp_Click"/>
                <MenuItem Header="Backup do projeto..." Click="ExportBackup_Click"/>
            </MenuItem>
            <MenuItem Header="Ajuda"/>
        </Menu>

        <Border x:Name="MainToolbarBorder" Grid.Row="2" Grid.ColumnSpan="3" Background="#E8E8E8" BorderBrush="#C8C8C8" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <Button x:Name="NewProjectButton"
                        Content="Novo"
                        Width="64"
                        Margin="3"
                        Click="NewProject_Click"
                        AutomationProperties.Name="Novo projeto"
                        AutomationProperties.AutomationId="NewProjectButton"/>
                <Button x:Name="OpenProjectButton"
                        Content="Abrir"
                        Width="64"
                        Margin="3"
                        Click="OpenProject_Click"
                        AutomationProperties.Name="Abrir projeto"
                        AutomationProperties.AutomationId="OpenProjectButton"/>
                <Button x:Name="SaveProjectButton"
                        Content="Salvar"
                        Width="64"
                        Margin="3"
                        Click="SaveProject_Click"
                        AutomationProperties.Name="Salvar projeto"
                        AutomationProperties.AutomationId="SaveProjectButton"/>
                <Separator Width="12"/>
                <Button x:Name="WallButton"
                        Content="Parede"
                        Width="72"
                        Margin="3"
                        Click="WallButton_Click"
                        AutomationProperties.Name="Parede"
                        AutomationProperties.AutomationId="WallButton"/>
                <Button x:Name="WallEditorButton"
                        Content="Editor Paredes"
                        Width="100"
                        Margin="3"
                        Click="WallEditorButton_Click"
                        AutomationProperties.Name="Editor de Paredes"
                        AutomationProperties.AutomationId="WallEditorButton"/>
                <StackPanel x:Name="WallEditorToolsPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="WallEditorLinearDimButton"
                            Content="Cota Reta"
                            Width="84"
                            Margin="3"
                            Click="WallEditorLinearDimButton_Click"
                            AutomationProperties.Name="Cota Reta"
                            AutomationProperties.AutomationId="WallEditorLinearDimButton"/>
                    <Button x:Name="WallEditorAngularDimButton"
                            Content="Cota Angular"
                            Width="96"
                            Margin="3"
                            Click="WallEditorAngularDimButton_Click"
                            AutomationProperties.Name="Cota Angular"
                            AutomationProperties.AutomationId="WallEditorAngularDimButton"/>
                    <Button x:Name="WallEditorRemoveDimButton"
                            Content="Remover Cota"
                            Width="100"
                            Margin="3"
                            Click="WallEditorRemoveDimButton_Click"
                            AutomationProperties.Name="Remover Cota"
                            AutomationProperties.AutomationId="WallEditorRemoveDimButton"/>
                    <Button x:Name="WallEditorHotpointButton"
                            Content="Mover HotPoint"
                            Width="108"
                            Margin="3"
                            Click="WallEditorHotpointButton_Click"
                            AutomationProperties.Name="Mover HotPoint"
                            AutomationProperties.AutomationId="WallEditorHotpointButton"/>
                    <Button x:Name="WallCornerJoinButton"
                            Content="Encontro Canto"
                            Width="108"
                            Margin="3"
                            Click="WallCornerJoinButton_Click"
                            AutomationProperties.Name="Encontro Canto"
                            AutomationProperties.AutomationId="WallCornerJoinButton"/>
                    <Button x:Name="WallTJoinButton"
                            Content="Encontro T"
                            Width="88"
                            Margin="3"
                            Click="WallTJoinButton_Click"
                            AutomationProperties.Name="Encontro T"
                            AutomationProperties.AutomationId="WallTJoinButton"/>
                </StackPanel>
                <Button x:Name="DoorButton"
                        Content="Porta"
                        Width="64"
                        Margin="3"
                        Click="DoorButton_Click"
                        AutomationProperties.Name="Porta"
                        AutomationProperties.AutomationId="DoorButton"/>
                <Button x:Name="WindowButton"
                        Content="Janela"
                        Width="72"
                        Margin="3"
                        Click="WindowButton_Click"
                        AutomationProperties.Name="Janela"
                        AutomationProperties.AutomationId="WindowButton"/>
                <Separator Width="12"/>
                <Button x:Name="DimensionConfiguratorButton"
                        Content="Dimensões"
                        Width="88"
                        Margin="3"
                        Click="OpenDimensionConfigurator_Click"
                        AutomationProperties.Name="Configurar Dimensões"
                        AutomationProperties.AutomationId="DimensionConfiguratorButton"/>
                <Separator Width="12"/>
                <Button x:Name="PerspectiveButton"
                        Content="Perspectiva"
                        Width="90"
                        Margin="3"
                        Click="PerspectiveButton_Click"
                        AutomationProperties.Name="Perspectiva"
                        AutomationProperties.AutomationId="PerspectiveButton"/>
                <Button x:Name="TopViewButton"
                        Content="Planta"
                        Width="64"
                        Margin="3"
                        Click="TopViewButton_Click"
                        AutomationProperties.Name="Planta"
                        AutomationProperties.AutomationId="TopViewButton"/>
                <Button x:Name="FrontViewButton"
                        Content="Frontal"
                        Width="64"
                        Margin="3"
                        Click="FrontViewButton_Click"
                        AutomationProperties.Name="Frontal"
                        AutomationProperties.AutomationId="FrontViewButton"/>
                <Button x:Name="LeftViewButton"
                        Content="Esquerda"
                        Width="76"
                        Margin="3"
                        Click="LeftViewButton_Click"
                        AutomationProperties.Name="Esquerda"
                        AutomationProperties.AutomationId="LeftViewButton"/>
                <Button x:Name="RightViewButton"
                        Content="Direita"
                        Width="64"
                        Margin="3"
                        Click="RightViewButton_Click"
                        AutomationProperties.Name="Direita"
                        AutomationProperties.AutomationId="RightViewButton"/>
                <Button x:Name="XRayButton"
                        Content="Raio X"
                        Width="64"
                        Margin="3"
                        Click="XRayButton_Click"
                        AutomationProperties.Name="Raio X"
                        AutomationProperties.AutomationId="XRayButton"/>
                <Separator Width="12"/>
                <Button x:Name="MaterialCopyButton"
                        Content="Copiar material"
                        Width="110"
                        Margin="3"
                        Click="MaterialCopyButton_Click"
                        AutomationProperties.Name="Copiar material"
                        AutomationProperties.AutomationId="MaterialCopyButton"/>
            </StackPanel>
        </Border>

        <Border x:Name="LeftLibraryBorder" Grid.Row="3" Grid.Column="0" Background="#F7F7F7" BorderBrush="#C8C8C8" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Bibliotecas" FontWeight="Bold" Margin="8" FontSize="14"/>
                <TabControl x:Name="LibraryTabControl" Margin="8,0,8,8">
                    <TabItem Header="Inserir"
                             AutomationProperties.Name="Inserir"
                             AutomationProperties.AutomationId="LibraryTabInsert">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4,0,0">
                                <TextBox x:Name="LibrarySearchBox"
                                         Margin="0,0,0,6"
                                         Height="26"
                                         TextChanged="LibrarySearchBox_TextChanged"
                                         AutomationProperties.Name="Buscar módulo no catálogo"
                                         AutomationProperties.AutomationId="LibrarySearchBox"/>
                                <TextBlock x:Name="LibrarySearchEmptyText"
                                           Text="Nenhum módulo encontrado."
                                           Margin="0,0,0,6"
                                           Foreground="#666666"
                                           FontSize="11"
                                           Visibility="Collapsed"
                                           AutomationProperties.AutomationId="LibrarySearchEmptyText"/>
                                <Expander x:Name="CozinhasLibraryExpander" Header="Cozinhas" IsExpanded="True"
                                          AutomationProperties.AutomationId="CozinhasLibraryExpander">
                                    <StackPanel x:Name="CozinhasLibraryHost"
                                                AutomationProperties.AutomationId="CozinhasLibraryHost"/>
                                </Expander>
                                <Expander x:Name="DormitoriosLibraryExpander" Header="Dormitórios" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Button x:Name="ModuleWardrobeButton"
                                                Content="Guarda-roupa 2 Portas"
                                                Margin="0,4"
                                                Height="32"
                                                Click="ModuleWardrobeButton_Click"
                                                AutomationProperties.AutomationId="ModuleWardrobeButton"/>
                                        <Button x:Name="ModuleNightstandButton"
                                                Content="Criado-mudo 2 Gavetas"
                                                Margin="0,4"
                                                Height="32"
                                                Click="ModuleNightstandButton_Click"
                                                AutomationProperties.AutomationId="ModuleNightstandButton"/>
                                        <Button x:Name="ModuleChestButton"
                                                Content="Cômoda 4 Gavetas"
                                                Margin="0,4"
                                                Height="32"
                                                Click="ModuleChestButton_Click"
                                                AutomationProperties.AutomationId="ModuleChestButton"/>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="CustomLibraryExpander" Header="Personalizados" Margin="0,8,0,0" IsExpanded="False">
                                    <StackPanel x:Name="CustomModulesPanel"/>
                                </Expander>
                                <Expander x:Name="PanelsLibraryExpander" Header="Painéis" Margin="0,8,0,0" IsExpanded="False">
                                    <StackPanel x:Name="PanelModulesPanel"/>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="LibraryTabScene"
                             Header="Ambiente"
                             AutomationProperties.Name="Ambiente"
                             AutomationProperties.AutomationId="LibraryTabScene">
                        <DockPanel>
                            <Button x:Name="SceneModuleDeleteButton"
                                    DockPanel.Dock="Bottom"
                                    Content="Excluir selecionado"
                                    Height="28"
                                    Margin="0,4,0,0"
                                    IsEnabled="False"
                                    Click="SceneModuleDeleteButton_Click"
                                    AutomationProperties.Name="Excluir módulo da lista"
                                    AutomationProperties.AutomationId="SceneModuleDeleteButton"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,4">
                                <CheckBox x:Name="SceneModuleVisibleCheck"
                                          Content="Visível"
                                          IsThreeState="True"
                                          IsChecked="True"
                                          IsEnabled="False"
                                          Checked="SceneModuleVisibleCheck_Changed"
                                          Unchecked="SceneModuleVisibleCheck_Changed"
                                          AutomationProperties.Name="Visibilidade do módulo no ambiente"
                                          AutomationProperties.AutomationId="SceneModuleVisibleCheck"/>
                                <CheckBox x:Name="SceneModuleLockedCheck"
                                          Margin="0,4,0,0"
                                          Content="Bloqueado"
                                          IsThreeState="True"
                                          IsChecked="False"
                                          IsEnabled="False"
                                          Checked="SceneModuleLockedCheck_Changed"
                                          Unchecked="SceneModuleLockedCheck_Changed"
                                          AutomationProperties.Name="Bloqueio do módulo no ambiente"
                                          AutomationProperties.AutomationId="SceneModuleLockedCheck"/>
                                <TextBlock Text="Nome no ambiente"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="#666666"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SceneModuleRenameBox"
                                             Height="28"
                                             IsEnabled="False"
                                             KeyDown="SceneModuleRenameBox_KeyDown"
                                             AutomationProperties.Name="Nome do módulo no ambiente"
                                             AutomationProperties.AutomationId="SceneModuleRenameBox"/>
                                    <Button x:Name="SceneModuleRenameButton"
                                            Grid.Column="1"
                                            Content="Aplicar"
                                            Height="28"
                                            Width="64"
                                            Margin="4,0,0,0"
                                            IsEnabled="False"
                                            Click="SceneModuleRenameButton_Click"
                                            AutomationProperties.Name="Aplicar nome do módulo"
                                            AutomationProperties.AutomationId="SceneModuleRenameButton"/>
                                </Grid>
                            </StackPanel>
                            <ListBox x:Name="SceneModuleListBox"
                                     SelectionMode="Extended"
                                     SelectionChanged="SceneModuleListBox_SelectionChanged"
                                     MouseDoubleClick="SceneModuleListBox_MouseDoubleClick"
                                     AutomationProperties.Name="Módulos no ambiente"
                                     AutomationProperties.AutomationId="SceneModuleList">
                                <ListBox.Resources>
                                    <DataTemplate DataType="{x:Type local:SceneModuleListGroupEntry}">
                                        <TextBlock Text="{Binding GroupTitle}"
                                                   Margin="0,8,0,2"
                                                   FontWeight="SemiBold"
                                                   Foreground="#444444"
                                                   AutomationProperties.AutomationId="SceneModuleListGroupHeader">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Compartment">
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Setter Property="Foreground" Value="#222222"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Wall">
                                                            <Setter Property="Margin" Value="12,4,0,2"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Setter Property="Foreground" Value="#555555"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type local:SceneModuleListItem}">
                                        <StackPanel Orientation="Horizontal" Margin="2,4" Opacity="{Binding ListOpacity}">
                                            <Border Width="28"
                                                    Height="28"
                                                    CornerRadius="2"
                                                    BorderBrush="#888888"
                                                    BorderThickness="1"
                                                    Background="{Binding AccentBrush}">
                                                <TextBlock Text="{Binding IconHint}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Padding" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="LibraryTabMaterials"
                             Header="Materiais"
                             AutomationProperties.Name="Materiais"
                             AutomationProperties.AutomationId="LibraryTabMaterials">
                        <local:MaterialsPanel x:Name="MaterialsPanel"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="3"
                      Grid.Column="0"
                      Width="6"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="CurrentAndNext"
                      ShowsPreview="False"
                      Background="#C8C8C8"
                      Cursor="SizeWE"
                      Panel.ZIndex="20"
                      ToolTip="Arraste para ajustar a largura das bibliotecas"
                      AutomationProperties.Name="Ajustar largura das bibliotecas"
                      AutomationProperties.AutomationId="LibraryWidthSplitter"/>

        <Border Grid.Row="3" Grid.Column="1" Background="#3A3A3A">
            <Grid x:Name="ViewportHost"
                  Background="#3A3A3A"
                  AllowDrop="True"
                  PreviewDragOver="ViewportHost_PreviewDragOver"
                  DragLeave="ViewportHost_DragLeave"
                  Drop="ViewportHost_Drop"
                  AutomationProperties.AutomationId="ViewportHost">
                <gl:GLWpfControl x:Name="Viewport"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Margin="0"
                         Focusable="True"
                         AutomationProperties.Name="Viewport 3D"
                         AutomationProperties.AutomationId="Viewport"/>

                <Canvas x:Name="DimensionLabelsCanvas"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

                <!-- Caixa Ctrl+arraste (Promob) — canvas próprio para não ser apagado com as cotas. -->
                <Canvas x:Name="ModuleMarqueeCanvas"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.AutomationId="ModuleMarqueeCanvas"/>

                <TextBox x:Name="MeasureBox"
                         Width="100"
                         Height="26"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,12,0,0"
                         Visibility="Collapsed"
                         PreviewKeyDown="MeasureBox_KeyDown"
                         AutomationProperties.Name="Medida"
                         AutomationProperties.AutomationId="MeasureBox"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3"
                      Grid.Column="2"
                      Width="6"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndCurrent"
                      ShowsPreview="False"
                      Background="#C8C8C8"
                      Cursor="SizeWE"
                      Panel.ZIndex="20"
                      ToolTip="Arraste para ajustar a largura das propriedades"
                      AutomationProperties.Name="Ajustar largura das propriedades"
                      AutomationProperties.AutomationId="PropertiesWidthSplitter"/>

        <Border x:Name="RightPropertiesBorder" Grid.Row="3" Grid.Column="2" Background="#F7F7F7" BorderBrush="#C8C8C8" BorderThickness="1,0,0,0">
