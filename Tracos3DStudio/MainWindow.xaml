                                            AutomationProperties.AutomationId="WallOpenBandsEditorButton"/>
                                    <Button x:Name="WallAddBandButton"
                                            Margin="0,6,0,0"
                                            Content="Definir faixa horizontal (dois cliques)"
                                            Click="WallAddBandButton_Click"
                                            AutomationProperties.AutomationId="WallAddBandButton"/>
                                    <Button x:Name="WallAddVerticalBandButton"
                                            Margin="0,6,0,0"
                                            Content="Definir faixa vertical (dois cliques)"
