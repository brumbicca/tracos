                                            Content="Girar região 90°"
                                            Click="WallRotateRegion90Button_Click"
                                            AutomationProperties.AutomationId="WallRotateRegion90Button"/>
                                    <Button x:Name="WallVerticalCutRegionButton"
                                            Margin="0,6,0,0"
                                            Content="Corte vertical"
                                            Click="WallVerticalCutRegionButton_Click"
                                            AutomationProperties.AutomationId="WallVerticalCutRegionButton"/>
                                    <Button x:Name="WallApplyVerticalCutButton"
                                            Margin="0,6,0,0"
