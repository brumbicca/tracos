                                      AutomationProperties.AutomationId="WallBandsExpander">
                                <StackPanel>
                                    <TextBlock Foreground="#666666" FontSize="11" TextWrapping="Wrap"
                                               Text="Divisões na parede. Dois cliques definem altura (horizontal) ou largura (vertical). Arraste linhas laranja (10 mm)."/>
                                    <Button x:Name="WallOpenBandsEditorButton"
                                            Margin="0,8,0,0"
                                            Content="Abrir editor de faixas..."
