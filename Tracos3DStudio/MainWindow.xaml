                                              Margin="0,2,0,0"
                                              SelectedIndex="0"
                                              SelectionChanged="WallConstructionTypeCombo_SelectionChanged"
                                              AutomationProperties.Name="Tipo da parede"
                                              AutomationProperties.AutomationId="WallConstructionTypeCombo">
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="Dry Wall"/>
                                    </ComboBox>
                                    <CheckBox x:Name="WallIsMovableCheck"
                                              Margin="0,4,0,0"
