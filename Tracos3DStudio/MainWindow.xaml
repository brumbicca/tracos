                                </StackPanel>
                            </Expander>
                            <Expander x:Name="FloorRegionsExpander" Header="Regiões" Margin="0,8,0,0" IsExpanded="True">
                                <StackPanel>
                                    <TextBlock Text="Regiões no piso (Promob). Retângulo, círculo ou polígono com material e offset."
                                               Foreground="#666666"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="FloorAddRegionButton"
                                            Margin="0,8,0,0"
                                            Content="Adicionar região retangular"
                                            Click="FloorAddRegionButton_Click"
                                            AutomationProperties.AutomationId="FloorAddRegionButton"/>
                                    <Button x:Name="FloorAddCircleRegionButton"
                                            Margin="0,6,0,0"
                                            Content="Definir região circular (clique)"
                                            Click="FloorAddCircleRegionButton_Click"
                                            AutomationProperties.AutomationId="FloorAddCircleRegionButton"/>
                                    <Button x:Name="FloorAddPolygonRegionButton"
                                            Margin="0,6,0,0"
                                            Content="Definir região por pontos"
                                            Click="FloorAddPolygonRegionButton_Click"
                                            AutomationProperties.AutomationId="FloorAddPolygonRegionButton"/>
                                    <TextBlock Text="Região" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="FloorZoneSelectorCombo"
                                              Margin="0,2,0,0"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="FloorZoneSelectorCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="FloorZoneSelectorCombo"/>
                                    <TextBlock Text="Material da região" Margin="0,6,0,0"/>
                                    <ComboBox x:Name="FloorZoneMaterialCombo"
                                              Margin="0,2,0,0"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="FloorZoneMaterialCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="FloorZoneMaterialCombo"/>
                                    <TextBlock Text="Offset forma (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="FloorRegionOffsetBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="FloorRegionOffsetBox_PreviewKeyDown"
                                             AutomationProperties.AutomationId="FloorRegionOffsetBox"/>
                                    <TextBlock Text="Offset por aresta (mm)" Margin="0,6,0,0"/>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="4"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="FloorRegionOffsetStartAlongBox"
                                                 Grid.Row="0" Grid.Column="0"
                                                 PreviewKeyDown="FloorRegionOffsetEdgeBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="FloorRegionOffsetStartAlongBox"/>
                                        <TextBox x:Name="FloorRegionOffsetEndAlongBox"
                                                 Grid.Row="0" Grid.Column="2"
                                                 PreviewKeyDown="FloorRegionOffsetEdgeBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="FloorRegionOffsetEndAlongBox"/>
                                        <TextBox x:Name="FloorRegionOffsetBottomBox"
                                                 Grid.Row="2" Grid.Column="0"
                                                 PreviewKeyDown="FloorRegionOffsetEdgeBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="FloorRegionOffsetBottomBox"/>
                                        <TextBox x:Name="FloorRegionOffsetTopBox"
                                                 Grid.Row="2" Grid.Column="2"
                                                 PreviewKeyDown="FloorRegionOffsetEdgeBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="FloorRegionOffsetTopBox"/>
                                    </Grid>
                                    <Button x:Name="FloorDeleteZoneButton"
                                            Margin="0,10,0,0"
                                            Content="Excluir região selecionada"
                                            Click="FloorDeleteZoneButton_Click"
                                            AutomationProperties.AutomationId="FloorDeleteZoneButton"/>
                                    <TextBlock x:Name="FloorRegionsSummaryText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Nenhuma região."/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- ═══════════════════════════════════════════
                             PAINEL DE MÓDULOS / GENÉRICO
                             ═══════════════════════════════════════════ -->
                        <StackPanel x:Name="ModulePropertiesPanel">
                            <Expander Header="Geral" IsExpanded="True">
                                <StackPanel>
                                    <TextBlock Text="Camada"/>
                                    <ComboBox x:Name="ModuleLayerCombo"
                                              Margin="0,2,0,0"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="ModuleLayerCombo_SelectionChanged"
                                              AutomationProperties.Name="Camada do módulo"
                                              AutomationProperties.AutomationId="ModuleLayerCombo"/>
                                    <TextBlock Foreground="#666666"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="Visível e bloqueado também na aba Ambiente. Camadas globais em Exibir → Camadas..."/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Dimensões" Margin="0,8,0,0" IsExpanded="True">
                                <StackPanel>
                                    <TextBlock x:Name="PropertyLengthLabel" Text="Comprimento (mm)"/>
                                    <TextBox x:Name="PropertyLengthBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="PropertyPanelBox_PreviewKeyDown"
                                             AutomationProperties.Name="Comprimento ou largura"
                                             AutomationProperties.AutomationId="PropertyLengthBox"/>
                                    <TextBlock x:Name="PropertyHeightLabel" Text="Altura (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="PropertyHeightBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="PropertyPanelBox_PreviewKeyDown"
                                             AutomationProperties.Name="Altura"
                                             AutomationProperties.AutomationId="PropertyHeightBox"/>
                                    <TextBlock x:Name="PropertyDepthLabel" Text="Espessura (mm)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="PropertyDepthBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="PropertyPanelBox_PreviewKeyDown"
                                             AutomationProperties.Name="Espessura ou posição na parede"
                                             AutomationProperties.AutomationId="PropertyDepthBox"/>
                                    <StackPanel x:Name="PropertyCornerMeasuresPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                        <TextBlock x:Name="PropertyCornerMeasureALabel" Text="Medida A (mm)"
                                                   ToolTip="Profundidade da asa A (Promob Avançado)"/>
                                        <TextBox x:Name="PropertyCornerMeasureABox"
                                                 Margin="0,2,0,0"
                                                 PreviewKeyDown="PropertyPanelBox_PreviewKeyDown"
                                                 AutomationProperties.Name="Medida A profundidade asa"
                                                 AutomationProperties.AutomationId="PropertyCornerMeasureABox"/>
                                        <StackPanel x:Name="PropertyCornerMeasureBPanel">
                                            <TextBlock x:Name="PropertyCornerMeasureBLabel" Text="Medida B (mm)"
                                                       Margin="0,6,0,0"
                                                       ToolTip="Profundidade da asa B (Promob Avançado)"/>
                                            <TextBox x:Name="PropertyCornerMeasureBBox"
                                                     Margin="0,2,0,0"
                                                     PreviewKeyDown="PropertyPanelBox_PreviewKeyDown"
                                                     AutomationProperties.Name="Medida B profundidade asa"
                                                     AutomationProperties.AutomationId="PropertyCornerMeasureBBox"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="PropertyObliquePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock Text="Quantidade de portas"/>
                                        <ComboBox x:Name="PropertyObliqueDoorCountCombo"
                                                  Margin="0,2,0,0"
                                                  SelectedIndex="0"
                                                  SelectionChanged="PropertyObliqueDoorCountCombo_SelectionChanged"
                                                  AutomationProperties.Name="Quantidade de portas do canto oblíquo"
                                                  AutomationProperties.AutomationId="PropertyObliqueDoorCountCombo">
                                            <ComboBoxItem Content="1 porta"/>
                                            <ComboBoxItem Content="2 portas"/>
                                        </ComboBox>
                                        <StackPanel x:Name="PropertyObliqueHingeSidePanel" Margin="0,6,0,0">
                                            <TextBlock Text="Lado de abertura"/>
                                            <ComboBox x:Name="PropertyObliqueHingeSideCombo"
                                                      Margin="0,2,0,0"
                                                      SelectedIndex="0"
                                                      SelectionChanged="PropertyObliqueHingeSideCombo_SelectionChanged"
                                                      AutomationProperties.Name="Lado de abertura do canto oblíquo"
                                                      AutomationProperties.AutomationId="PropertyObliqueHingeSideCombo">
                                                <ComboBoxItem Content="Esquerda"/>
                                                <ComboBoxItem Content="Direita"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="PropertySpecialColumnPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock x:Name="PropertySpecialColumnPositionText"
                                                   FontWeight="SemiBold" Text="Recorte para coluna"/>
                                        <TextBlock Text="Largura da coluna (mm)" Margin="0,6,0,0"/>
                                        <TextBox x:Name="PropertySpecialColumnWidthBox"
                                                 Margin="0,2,0,0"
                                                 PreviewKeyDown="PropertyPanelBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PropertySpecialColumnWidthBox"/>
                                        <TextBlock Text="Profundidade da coluna (mm)" Margin="0,6,0,0"/>
                                        <TextBox x:Name="PropertySpecialColumnDepthBox"
                                                 Margin="0,2,0,0"
                                                 PreviewKeyDown="PropertyPanelBox_PreviewKeyDown"
                                                 AutomationProperties.AutomationId="PropertySpecialColumnDepthBox"/>
                                        <StackPanel x:Name="PropertySpecialColumnOffsetPanel" Margin="0,6,0,0">
                                            <TextBlock Text="Posição a partir da esquerda (mm)"/>
                                            <TextBox x:Name="PropertySpecialColumnOffsetBox"
                                                     Margin="0,2,0,0"
                                                     PreviewKeyDown="PropertyPanelBox_PreviewKeyDown"
                                                     AutomationProperties.AutomationId="PropertySpecialColumnOffsetBox"/>
                                        </StackPanel>
                                        <TextBlock Text="Prateleiras" Margin="0,6,0,0"/>
                                        <ComboBox x:Name="PropertySpecialColumnShelfCombo"
                                                  Margin="0,2,0,0"
                                                  SelectionChanged="PropertySpecialColumnShelfCombo_SelectionChanged"
                                                  AutomationProperties.AutomationId="PropertySpecialColumnShelfCombo">
                                            <ComboBoxItem Content="Recortadas na coluna"/>
                                            <ComboBoxItem Content="Alinhadas após a coluna"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock x:Name="PropertyHintText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Selecione uma abertura ou módulo. Enter confirma."/>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="PartParametrizationExpander" Header="Seta — dimensão da peça" Margin="0,8,0,0" IsExpanded="True" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Foreground="#666666" FontSize="11" TextWrapping="Wrap"
                                               Text="Clique numa seta no 3D para escolher o eixo. Informe o ajuste (ex.: -150) e Aplicar — o valor permanece no campo como referência do parametrizado."/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="PartWidthLabel" Grid.Row="0" Grid.Column="0" Text="Largura" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="PartWidthValueBox" IsReadOnly="True" IsTabStop="False" Background="#F2F2F2" Margin="0,0,6,4"
                                                   AutomationProperties.AutomationId="PartWidthValueBox"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="+" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                        <TextBox   Grid.Row="0" Grid.Column="3" x:Name="PartWidthDeltaBox" Margin="0,0,0,4"
                                                   GotFocus="PartWidthDeltaBox_GotFocus"
                                                   PreviewKeyDown="PartDeltaBox_PreviewKeyDown"
                                                   AutomationProperties.Name="Ajuste de largura da peça"
                                                   AutomationProperties.AutomationId="PartWidthDeltaBox"/>

                                        <TextBlock x:Name="PartDepthLabel" Grid.Row="1" Grid.Column="0" Text="Profundidade" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PartDepthValueBox" IsReadOnly="True" IsTabStop="False" Background="#F2F2F2" Margin="0,0,6,4"
                                                   AutomationProperties.AutomationId="PartDepthValueBox"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="+" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                        <TextBox   Grid.Row="1" Grid.Column="3" x:Name="PartDepthDeltaBox" Margin="0,0,0,4"
                                                   GotFocus="PartDepthDeltaBox_GotFocus"
                                                   PreviewKeyDown="PartDeltaBox_PreviewKeyDown"
                                                   AutomationProperties.Name="Ajuste de profundidade da peça"
                                                   AutomationProperties.AutomationId="PartDepthDeltaBox"/>

                                        <TextBlock x:Name="PartHeightLabel" Grid.Row="2" Grid.Column="0" Text="Altura" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PartHeightValueBox" IsReadOnly="True" IsTabStop="False" Background="#F2F2F2" Margin="0,0,6,0"
                                                   AutomationProperties.AutomationId="PartHeightValueBox"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="+" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox   Grid.Row="2" Grid.Column="3" x:Name="PartHeightDeltaBox"
                                                   GotFocus="PartHeightDeltaBox_GotFocus"
                                                   PreviewKeyDown="PartDeltaBox_PreviewKeyDown"
                                                   AutomationProperties.Name="Ajuste de altura da peça"
                                                   AutomationProperties.AutomationId="PartHeightDeltaBox"/>
                                    </Grid>

                                    <Button x:Name="PartApplyButton" Content="Aplicar" Margin="0,8,0,0" HorizontalAlignment="Right" Padding="16,3"
                                            Click="PartApplyButton_Click"
                                            AutomationProperties.AutomationId="PartApplyButton"/>

                                    <TextBlock x:Name="PartParametrizationHintText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Selecione uma peça (duplo clique no módulo)."/>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="ModuleCotasExpander" Header="Cotas" Margin="0,8,0,0" IsExpanded="True" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Cota Anterior (mm)"/>
                                    <TextBlock Foreground="#666666" FontSize="11" Text="Do encontro interno da parede até a face esquerda do módulo."/>
                                    <TextBox x:Name="ModuleCotaAnteriorBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="ModuleCotaBox_PreviewKeyDown"
                                             AutomationProperties.AutomationId="ModuleCotaAnteriorBox"/>
                                    <TextBlock Text="Cota Posterior (mm)" Margin="0,6,0,0"/>
                                    <TextBlock Foreground="#666666" FontSize="11" Text="Da face direita do módulo até o fim da face interna."/>
                                    <TextBox x:Name="ModuleCotaPosteriorBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="ModuleCotaBox_PreviewKeyDown"
                                             AutomationProperties.AutomationId="ModuleCotaPosteriorBox"/>
                                    <TextBlock Text="Cota Inferior (mm)" Margin="0,6,0,0"/>
                                    <TextBlock Foreground="#666666" FontSize="11" Text="Do piso (eixo vertical da parede) até a base do módulo."/>
                                    <TextBox x:Name="ModuleCotaInferiorBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="ModuleCotaBox_PreviewKeyDown"
                                             AutomationProperties.AutomationId="ModuleCotaInferiorBox"/>
                                    <TextBlock Text="Cota Superior (mm)" Margin="0,6,0,0"/>
                                    <TextBlock Foreground="#666666" FontSize="11" Text="Do topo do módulo até o pé-direito da parede."/>
                                    <TextBox x:Name="ModuleCotaSuperiorBox"
                                             Margin="0,2,0,0"
                                             PreviewKeyDown="ModuleCotaBox_PreviewKeyDown"
                                             AutomationProperties.AutomationId="ModuleCotaSuperiorBox"/>
                                    <TextBlock x:Name="ModuleCotasHintText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Enter confirma cada cota. Referência: face interna (encontro das paredes)."/>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="MaterialsExpander" Header="Materiais" Margin="0,8,0,0" IsExpanded="False">
                                <StackPanel>
                                    <TextBlock Text="Acabamento"/>
                                    <ComboBox x:Name="PropertyMaterialCombo"
                                              Margin="0,4,0,0"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="PropertyMaterialCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="PropertyMaterialCombo"/>
                                    <TextBlock x:Name="PropertyMaterialHintText"
                                               Margin="0,8,0,0"
                                               Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Disponível ao selecionar um módulo."/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Agregados" Margin="0,8,0,0"/>
                            <Expander x:Name="MovementExpander" Header="Movimentação" Margin="0,8,0,0" IsExpanded="False">
                                <StackPanel>
                                    <Button x:Name="RotateModule90Button"
                                            Content="Girar 90°"
                                            Height="32"
                                            Margin="0,4"
                                            Click="RotateModule90Button_Click"
                                            AutomationProperties.AutomationId="RotateModule90Button"/>
                                    <TextBlock Foreground="#666666"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="Atalho: R com módulo selecionado. Delete remove o módulo."/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Multiplicação" Margin="0,8,0,0"/>
                            <Expander x:Name="ModelsExpander" Header="Modelos" Margin="0,8,0,0" Visibility="Collapsed" IsExpanded="True">
                                <StackPanel x:Name="PropertyDrawerHardwarePanel">
                                    <TextBlock Text="Tipo de corrediça"/>
                                    <ComboBox x:Name="PropertyDrawerSlideTypeCombo"
                                              Margin="0,2,0,0"
                                              SelectionChanged="PropertyDrawerSlideTypeCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="PropertyDrawerSlideTypeCombo">
                                        <ComboBoxItem x:Name="PropertyTelescopicSlideItem" Content="Telescópica"/>
                                        <ComboBoxItem x:Name="PropertyConcealedSlideItem" Content="Invisível"/>
                                    </ComboBox>
                                    <TextBlock x:Name="PropertyDrawerSlideHintText"
                                               Margin="0,6,0,0"
                                               Foreground="#666666"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Ferragens" Margin="0,8,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border x:Name="StatusBarBorder" Grid.Row="4" Grid.ColumnSpan="3" Background="#EAEAEA" BorderBrush="#C8C8C8" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="CollisionToggleButton"
                        DockPanel.Dock="Right"
                        Content="Colisão: ON"
                        Width="104"
                        Height="22"
                        Margin="4,2"
                        Click="CollisionToggleButton_Click"
                        AutomationProperties.Name="Alternar colisão"
                        AutomationProperties.AutomationId="CollisionToggleButton"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBarProjectText"
                               Margin="8,0,0,0"
                               FontSize="11"
                               AutomationProperties.Name="Status bar projeto"
                               AutomationProperties.AutomationId="StatusBarProjectText"/>
                    <Border Width="1"
                            Height="14"
                            Background="#C8C8C8"
                            Margin="8,0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusBarViewContextText"
                               FontSize="11"
                               AutomationProperties.Name="Status bar vista e seleção"
                               AutomationProperties.AutomationId="StatusBarViewContextText"/>
                    <Border Width="1"
                            Height="14"
                            Background="#C8C8C8"
                            Margin="8,0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusBarMaterialText"
                               FontSize="11"
                               Foreground="#444444"
                               AutomationProperties.Name="Status bar material"
                               AutomationProperties.AutomationId="StatusBarMaterialText"/>
                    <Border x:Name="StatusBarHintSeparator"
                            Width="1"
                            Height="14"
                            Background="#C8C8C8"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusBarHintText"
                               FontSize="11"
                               Foreground="#005A9E"
                               Visibility="Collapsed"
                               AutomationProperties.Name="Status bar dica"
                               AutomationProperties.AutomationId="StatusBarHintText"/>
                    <Border Width="1"
                            Height="14"
                            Background="#C8C8C8"
                            Margin="8,0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusBarStatusText"
                               Margin="0,0,8,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="Status bar status"
                               AutomationProperties.AutomationId="StatusBarStatusText"/>
                    <TextBlock x:Name="StatusBarText"
                               Width="1"
                               Height="1"
                               Opacity="0"
                               AutomationProperties.Name="Barra de status"
                               AutomationProperties.AutomationId="StatusBarText"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
