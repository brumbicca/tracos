<Window x:Class="Tracos3DStudio.BudgetAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auditoria pré-orçamento"
        Width="720"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        AutomationProperties.Name="Auditoria pré-orçamento"
        AutomationProperties.AutomationId="BudgetAuditWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ProjectTitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   x:Name="SummaryText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="BudgetAuditSummaryText"/>

        <DataGrid Grid.Row="2"
                  x:Name="FindingsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AutomationProperties.AutomationId="BudgetAuditFindingsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nível" Binding="{Binding SeverityText}" Width="80"/>
                <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ContinueButton"
                    Content="Continuar para orçamento"
                    Width="170"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="Continue_Click"
                    AutomationProperties.AutomationId="BudgetAuditContinueButton"/>
            <Button Content="Fechar"
                    Width="88"
                    Height="32"
                    IsCancel="True"
                    Click="Close_Click"
                    AutomationProperties.AutomationId="BudgetAuditCloseButton"/>
        </StackPanel>
    </Grid>
</Window>
